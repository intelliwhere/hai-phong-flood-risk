var activeLayers={flood:true,elev:false,rivers:false,rbuf:false,slr:false,typh:false,drain:false,surge:false};

function updateLegend(){
  var on=Object.keys(activeLayers).filter(function(k){return activeLayers[k]});
  var any=on.length>0;
  document.getElementById("ldot").style.background=any?"#69f0ae":"#1b7fa0";
  if(on.length===0){
    document.getElementById("leg-title").textContent="No layers active";
    document.getElementById("leg-content").innerHTML="<div style=\"color:#334455;font-size:11px;padding:4px 0\">Toggle a layer above to see its legend.</div>";
    return;
  }
  if(on.length===1){
    var k=on[0];
    document.getElementById("leg-title").textContent=LAYER_LEGENDS[k].title;
    document.getElementById("leg-content").innerHTML=LAYER_LEGENDS[k].html;
    return;
  }
  // Multiple active — show combined
  document.getElementById("leg-title").textContent="Active layers";
  var combined="";
  on.forEach(function(k){
    combined+="<div class=\"leg-section\"><div class=\"leg-section-title\">"+LAYER_LEGENDS[k].title+"</div>"+LAYER_LEGENDS[k].html+"</div>";
  });
  document.getElementById("leg-content").innerHTML=combined;
}

