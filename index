// ── SHEETS ────────────────────────────────────────────────
var _sheetTimer=null;
function openSheet(id){
  // Close all instantly, open target after one paint
  document.querySelectorAll(".sheet").forEach(function(s){s.classList.remove("open")});
  document.getElementById("layer-panel").classList.remove("open");
  if(_sheetTimer){clearTimeout(_sheetTimer)}
  _sheetTimer=setTimeout(function(){
    var el=document.getElementById(id);
    if(el){el.classList.add("open")}
  },16);
}
function closeSheet(id){
  var el=document.getElementById(id);
  if(el){el.classList.remove("open")}
}

