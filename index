  badge.textContent=d.risk;
  var bc=d.score>=5?"rgba(211,47,47,.25)":d.score>=4?"rgba(245,124,0,.25)":"rgba(249,168,37,.2)";
  var tc=d.score>=5?"#ff5252":d.score>=4?"#ffb74d":"#ffd54f";
  badge.style.cssText="background:"+bc+";color:"+tc+";border:1px solid "+tc+"88";
  document.getElementById("d-elev").textContent=d.elev;
  document.getElementById("d-haz").textContent=d.haz;
  document.getElementById("d-inc").textContent=d.inc;
