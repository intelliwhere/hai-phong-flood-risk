function togLayer(key,on){
  activeLayers[key]=on;
  if(key==="flood"){
    if(on){floodGroup.addTo(map);floodLabels.addTo(map);}
    else{map.removeLayer(floodGroup);map.removeLayer(floodLabels);}
    updateLegend();return;
  }
  var it=SL[key];if(!it)return;
  if(on){it.addTo(map);}
  else{map.removeLayer(it);}
  updateLegend();
}

